{
  "_come_si_modifica": "Modifica solo i valori. Attenzione a virgole e virgolette: se sbagli, il Radar te lo dice con il numero di riga. Per spegnere una fonte metti \"enabled\": false.",

  "timezone": "Europe/Rome",

  "thresholds": {
    "_notify": "Punteggio minimo (0-10) per ricevere subito una notifica. Più alto = meno notifiche.",
    "notify": 7.0,
    "_digest_min": "Sotto la soglia ma sopra questo valore: finisce nel riepilogo serale.",
    "digest_min": 5.0,
    "_force": "Se l'impatto è almeno questo e la fonte è ufficiale/trade, notifica comunque (es. morti, cancellazioni, annunci enormi).",
    "force_notify_impact": 9
  },

  "max_notifications_per_run": 5,
  "max_age_hours": 8,
  "first_run_max_age_hours": 3,

  "digest": { "enabled": true, "hour": 20, "max_items": 15 },

  "quiet_hours": {
    "_nota": "Di notte le notifiche arrivano senza suono, tranne quelle con punteggio >= override_score.",
    "enabled": true,
    "start": "00:30",
    "end": "07:30",
    "override_score": 9.0
  },

  "weights": {
    "_nota": "Quanto pesa ogni voce nel punteggio base.",
    "impact": 0.45,
    "audience_fit": 0.35,
    "traffic": 0.20
  },

  "insider_reliability": 0.95,
  "reliability_factor": {
    "ufficiale": 1.0,
    "trade": 0.95,
    "stampa": 0.85,
    "rumor": 0.75,
    "opinione": 0.4
  },

  "freshness_steps": [[60, 1.0], [180, 0.95], [360, 0.85], [720, 0.7], [100000, 0.5]],
  "saturation_steps": [[3, 1.0], [999, 0.95]],
  "italian_coverage_steps": [[0, 1.0], [1, 0.85], [999, 0.65]],

  "exclude_title_patterns": [
    "\\b(black friday|cyber monday|prime day|promo code|coupon|gift guide|buying guide|where to buy|on sale now)\\b|\\bbest\\b.{0,40}\\bdeals?\\b|\\bdeals? (on|for|alert)\\b|\\d+% off",
    "\\b(codice sconto|codici sconto|migliori offerte|offerte (del giorno|lampo|su)|in offerta|sconti (su|del|fino)|dove comprare|dove acquistare|black friday)\\b",
    "\\b(wordle|quordle|nyt connections|nyt strands|horoscope|oroscopo|crossword)\\b",
    "\\b(how to watch|where to watch|dove vedere|come vedere)\\b",
    "\\b(walkthrough|how to (beat|get|unlock|find|solve))\\b",
    "\\b(review|recensione)\\b"
  ],

